generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  password        String
  name            String?
  avatarUrl       String?
  avatarEffect    String    @default("none") // <-- ДОБАВИЛИ ЭФФЕКТ АВАТАРА
  bannerUrl       String?
  bio             String?
  telegram        String?
  phone           String?
  role            String    @default("USER")
  status          String    @default("ACTIVE")
  subscriptionEnd DateTime?
  createdAt       DateTime  @default(now())
  
  playlists        Playlist[] // <-- ВОЗВРАЩАЕМ ПЛЕЙЛИСТЫ
  likes            Like[]
  listenHistory    ListenHistory[]
  pinnedTracks     PinnedTrack[]
  visitLogs        VisitLog[]
  subscriptionLogs SubscriptionLog[]
  feedback         Feedback[]
  importTasks      ImportTask[]
  
  createdInvites   InviteCode[] @relation("CreatedInvites")
  usedInvite       InviteCode?  @relation("UsedInvite")
}

model Track {
  id          String   @id @default(uuid())
  title       String
  artist      String
  coverUrl    String?
  audioUrl    String
  duration    Int
  genre       String?
  releaseYear Int?
  hash        String?  @unique
  createdAt   DateTime @default(now())

  playlists     PlaylistItem[]
  likes         Like[]
  listenHistory ListenHistory[]
  pinnedTracks  PinnedTrack[]
}

model Playlist {
  id        String         @id @default(cuid())
  title     String
  isPublic  Boolean        @default(false)
  coverUrl  String?
  createdAt DateTime       @default(now())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     PlaylistItem[]
}

model PlaylistItem {
  id         String   @id @default(cuid())
  playlistId String
  trackId    String
  order      Int
  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  track      Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)
}

model Like {
  id        String @id @default(uuid())
  userId    String
  trackId   String
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  track     Track  @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@unique([userId, trackId])
}

model ListenHistory {
  id        String   @id @default(cuid())
  userId    String
  trackId   String
  playedAt  DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  track     Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)
}

model PinnedTrack {
  id        String   @id @default(cuid())
  userId    String
  trackId   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  track     Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@unique([userId, trackId])
}

model ImportLog {
  id        String   @id @default(cuid())
  ipAddress String
  createdAt DateTime @default(now())
}

model VisitLog {
  id        String   @id @default(cuid())
  path      String
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model SubscriptionLog {
  id        String   @id @default(cuid())
  userId    String
  plan      String
  startDate DateTime @default(now())
  endDate   DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Feedback {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  type      String   @default("OTHER")
  message   String
  status    String   @default("NEW")
  adminNote String?
  createdAt DateTime @default(now())
}

model InviteCode {
  id        String   @id @default(cuid())
  code      String   @unique
  createdBy String?
  creator   User?    @relation("CreatedInvites", fields: [createdBy], references: [id], onDelete: SetNull)
  usedBy    String?  @unique
  user      User?    @relation("UsedInvite", fields: [usedBy], references: [id], onDelete: SetNull)
  usedAt    DateTime?
  expiresAt DateTime?
  createdAt DateTime @default(now())
}

model ImportTask {
  id           String   @id @default(cuid())
  batchId      String
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title        String
  artist       String
  status       String   @default("PENDING")
  errorMessage String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}